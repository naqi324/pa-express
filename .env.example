# Prior Auth Express environment reference.
#
# The app reads settings from process environment variables with the
# PA_EXPRESS_ prefix. It does not auto-load this file. Do not put real secrets
# here; export them through your shell, run configuration, or the in-app session
# engine configuration forms.

# App mode and session behavior
PA_EXPRESS_HOSTED_MODE=false
PA_EXPRESS_ALLOWED_ORIGINS=http://127.0.0.1:5175,http://localhost:5175
PA_EXPRESS_TRUSTED_HOSTS=127.0.0.1,localhost,testserver
PA_EXPRESS_SESSION_COOKIE_NAME=pa_express_session
PA_EXPRESS_SESSION_IDLE_MINUTES=60
PA_EXPRESS_SESSION_COOKIE_SECURE=false
PA_EXPRESS_SESSION_COOKIE_SAME_SITE=lax

# Engine availability
PA_EXPRESS_CLAUDE_ENABLED=true
PA_EXPRESS_OPENAI_GPT_ENABLED=true

# Anthropic Claude. Auth method: cli, api_key, or bedrock.
# Models: claude-opus-5-5, claude-fable-5-1, claude-sonnet-5,
# claude-haiku-4-5-20251001. Efforts: low, medium, high, xhigh, max
# (Claude Haiku 4.5 takes no effort). Leave the effort empty for the model's
# default. The catalog in backend/app/engines/catalog.py is authoritative.
PA_EXPRESS_CLAUDE_AUTH_METHOD=cli
PA_EXPRESS_CLAUDE_MODEL_ID=claude-opus-5-5
PA_EXPRESS_CLAUDE_EFFORT=high
PA_EXPRESS_CLAUDE_MAX_TOKENS=16000
PA_EXPRESS_CLAUDE_COMMAND=claude
# Secret. Prefer the in-app form, which keeps the key in server memory only.
PA_EXPRESS_ANTHROPIC_API_KEY=
PA_EXPRESS_BEDROCK_REGION=us-west-2
# profile or access_keys.
PA_EXPRESS_BEDROCK_CREDENTIALS=profile
# Empty uses the standard AWS credential chain (environment variables, the
# default shared profile, SSO, or an instance role). Set a name to pin a profile.
PA_EXPRESS_AWS_PROFILE=
# Secrets, used only with PA_EXPRESS_BEDROCK_CREDENTIALS=access_keys.
PA_EXPRESS_AWS_ACCESS_KEY_ID=
PA_EXPRESS_AWS_SECRET_ACCESS_KEY=
PA_EXPRESS_AWS_SESSION_TOKEN=

# OpenAI GPT. Auth method: cli or api_key.
# Models: gpt-6-astra, gpt-6-sol, gpt-6-luna. Efforts depend on the model and
# auth method: the Codex CLI adds ultra for Astra and Sol, and the API adds none
# for Sol and Luna.
PA_EXPRESS_OPENAI_GPT_AUTH_METHOD=cli
PA_EXPRESS_OPENAI_GPT_MODEL_ID=gpt-6-astra
PA_EXPRESS_OPENAI_GPT_EFFORT=high
PA_EXPRESS_CODEX_COMMAND=codex
# Secret. Prefer the in-app form, which keeps the key in server memory only.
PA_EXPRESS_OPENAI_API_KEY=

# Timeouts and demo timing
PA_EXPRESS_ENGINE_TIMEOUT_SECONDS=120
PA_EXPRESS_MOCK_PROCESSING_SECONDS=2.2

# E2E override, read by Playwright rather than the backend.
# E2E_BASE_URL=http://127.0.0.1:5175
